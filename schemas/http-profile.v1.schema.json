{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoplane.local/schemas/http-profile.v1.schema.json",
  "title": "RepoPlane HTTP host profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_uri", "auth"],
  "properties": {
    "listen": {"type": "string"},
    "endpoint": {"type": "string", "pattern": "^/[^?]+$"},
    "resource_uri": {"type": "string", "format": "uri"},
    "allowed_origins": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
    "allowed_hosts": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
    "tls": {
      "type": "object", "additionalProperties": false,
      "properties": {"cert_file": {"type": "string"}, "key_file": {"type": "string"}}
    },
    "auth": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {
        "mode": {"enum": ["local_token", "oauth_introspection"]},
        "token_file": {"type": "string"},
        "scopes": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
        "introspection_url": {"type": "string", "format": "uri"},
        "client_id_env": {"type": "string"},
        "client_secret_env": {"type": "string"},
        "authorization_servers": {"type": "array", "items": {"type": "string", "format": "uri"}, "maxItems": 16},
        "audience": {"type": "string"}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "body_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "concurrent_requests": {"type": "integer", "minimum": 1, "maximum": 1024},
        "per_principal": {"type": "integer", "minimum": 1, "maximum": 1024},
        "requests_per_minute": {"type": "integer", "minimum": 1, "maximum": 100000},
        "read_header_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "read_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "idle_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "shutdown_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "properties": {"retention_days": {"type": "integer", "minimum": 1, "maximum": 3650}}
    }
  }
}
