{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoplane.local/schemas/catalog-item.v1.schema.json",
  "title": "RepoPlane catalog item",
  "type": "object",
  "required": ["id", "revision", "summary"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "use_when": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "execution": {
      "type": "object",
      "required": ["kind", "executable_ref", "cwd", "argv_template", "trusted_for_run"],
      "properties": {
        "kind": { "const": "cli" },
        "executable_ref": { "type": "string" },
        "cwd": { "type": "string" },
        "argv_template": { "type": "array", "items": { "type": "string" } },
        "trusted_for_run": { "type": "boolean" },
        "timeout_sec": { "type": "integer", "maximum": 86400 },
        "artifact_mode": { "enum": ["metadata", "capture"] },
        "preflight": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "kind"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
              "kind": { "enum": ["executable", "file", "environment", "git", "platform"] },
              "ref": { "type": "string", "maxLength": 4096 },
              "requirement": { "enum": ["required", "recommended", "informational"] },
              "argv": { "type": "array", "maxItems": 32, "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "arguments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "required": { "type": "boolean" },
          "default": true,
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "checks": { "type": "array", "items": { "type": "string" } },
    "docs": { "type": "array", "items": { "type": "string" } },
    "cache_policy": { "enum": ["disabled", "observe", "verified"] },
    "cache": {
      "type": "object",
      "required": ["contract_revision", "output_contract", "restore_policy", "assumptions"],
      "properties": {
        "contract_revision": { "type": "integer", "minimum": 1 },
        "output_contract": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "key_checks": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string" } },
        "qualification_checks": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
        "restore_policy": { "enum": ["missing_or_matching", "replace_isolated_root"] },
        "isolated_root": { "type": "string", "maxLength": 4096 },
        "assumptions": {
          "type": "object",
          "required": ["inputs_complete", "outputs_complete", "external_state", "nondeterminism", "side_effects"],
          "properties": {
            "inputs_complete": { "const": true },
            "outputs_complete": { "const": true },
            "external_state": { "const": "none" },
            "nondeterminism": { "const": "none" },
            "side_effects": { "const": "declared_outputs_only" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "required": ["cache"] },
      "then": { "required": ["cache_policy"], "properties": { "cache_policy": { "enum": ["observe", "verified"] } } }
    },
    {
      "if": { "properties": { "cache_policy": { "enum": ["observe", "verified"] } }, "required": ["cache_policy"] },
      "then": {
        "required": ["cache", "execution", "inputs", "outputs"],
        "properties": {
          "inputs": { "minItems": 1 },
          "outputs": { "minItems": 1 },
          "execution": { "properties": { "trusted_for_run": { "const": true }, "artifact_mode": { "const": "capture" } }, "required": ["artifact_mode"] }
        }
      }
    },
    {
      "if": { "properties": { "cache_policy": { "const": "verified" } }, "required": ["cache_policy"] },
      "then": { "properties": { "cache": { "properties": { "qualification_checks": { "minItems": 1 } }, "required": ["qualification_checks"] } } }
    },
    {
      "if": { "properties": { "cache": { "properties": { "restore_policy": { "const": "replace_isolated_root" } }, "required": ["restore_policy"] } }, "required": ["cache"] },
      "then": { "properties": { "cache": { "required": ["isolated_root"] } } }
    }
  ],
  "additionalProperties": false
}
