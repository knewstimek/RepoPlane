{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoplane.local/schemas/verification-result.v1.schema.json",
  "title": "RepoPlane imported verification result payload",
  "type": "object",
  "required": ["operation", "status", "subject", "counts", "checks", "truncated", "report_hash", "parser_revision", "raw_storage", "source_path", "check_id", "checklist_revision", "checklist_hash", "configuration", "applies_to", "required", "capability", "outcome"],
  "properties": {
    "operation": { "enum": ["verify", "preflight", "public-release-check"] },
    "status": { "enum": ["passed", "failed", "partial"] },
    "subject": {
      "type": "object",
      "properties": {
        "git_commit": { "type": "string", "maxLength": 64 },
        "dirty": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["passed", "failed", "unknown"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "status": { "enum": ["passed", "failed", "unknown"] }
        },
        "additionalProperties": false
      }
    },
    "truncated": { "type": "boolean" },
    "report_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "parser_revision": { "const": "check-report.v1-parser.1" },
    "raw_storage": { "const": "hash_only" },
    "source_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "check_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "checklist_revision": { "type": "integer", "minimum": 1 },
    "checklist_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "configuration": { "type": "string", "minLength": 1, "maxLength": 128 },
    "applies_to": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "maxLength": 1024 } },
    "required": { "type": "boolean" },
    "capability": { "type": "string", "minLength": 1, "maxLength": 128 },
    "outcome": { "enum": ["passed", "failed", "not_run", "unknown"] }
  },
  "additionalProperties": false
}
