{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoplane.local/schemas/symbol-index.v1.schema.json",
  "title": "RepoPlane symbol-index.v1 JSONL record",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "path"],
  "properties": {
    "_type": {"type": "string", "enum": ["tag"]},
    "name": {"type": "string", "minLength": 1},
    "kind": {"type": "string"},
    "language": {"type": "string"},
    "path": {"type": "string", "minLength": 1},
    "line": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^[1-9][0-9]*$"}]},
    "source_revision": {"type": "string"}
  }
}
