{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoplane.local/schemas/memo.v1.schema.json",
  "title": "RepoPlane decision or failure memo payload",
  "type": "object",
  "required": ["memo_kind", "scope", "configuration", "content", "invalidation_condition"],
  "properties": {
    "memo_kind": { "enum": ["decision", "failed_attempt", "resolved_failure", "limitation", ""] },
    "scope": { "type": "string", "maxLength": 4096 },
    "configuration": { "type": "string", "maxLength": 4096 },
    "title": { "type": "string", "maxLength": 160 },
    "summary": { "type": "string", "maxLength": 240 },
    "temporal_kind": { "enum": ["historical_observation", "current_guidance"] },
    "as_of": { "type": "string", "format": "date-time" },
    "content": { "type": "string", "maxLength": 32768 },
    "invalidation_condition": { "type": "string", "maxLength": 32768 }
  },
  "additionalProperties": false
}
