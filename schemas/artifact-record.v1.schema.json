{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoplane.local/schemas/artifact-record.v1.schema.json",
  "title": "RepoPlane observed run artifact",
  "type": "object",
  "required": ["run_ref", "path", "content_hash", "size", "storage", "basis", "writer_attribution"],
  "properties": {
    "run_ref": { "type": "string", "maxLength": 256 },
    "path": { "type": "string", "maxLength": 4096 },
    "content_hash": { "type": "string", "maxLength": 256 },
    "size": { "type": "integer", "minimum": 0 },
    "storage": { "enum": ["metadata_only", "stored", "not_stored_limit", "not_stored_error", "deleted", "redacted"] },
    "basis": { "enum": ["declared", "observed", "derived", "heuristic", "reused"] },
    "writer_attribution": { "enum": ["isolated", "unknown", "cache"] }
  },
  "additionalProperties": false
}
